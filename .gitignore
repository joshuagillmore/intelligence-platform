# Local compose overrides
docker-compose.override.yml

# MITRE ATT&CK bundle cache (~50 MB, fetched on demand; ATTRIBUTION.md is kept)
data/attack/*.json
# CWE/CAPEC caches for CVE->ATT&CK chaining (fetched on demand; Phase 3a)
data/attack/*.xml
data/attack/*.zip

# Data volumes & editor/OS cruft
neo4j_data/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code personal layer (per-machine, not shared)
CLAUDE.local.md
.claude/settings.local.json

# Playwright E2E (auth state holds a JWT; artifacts regenerate)
frontend/tests/e2e/.auth/
frontend/tests/e2e/screenshots/
frontend/playwright-report/
frontend/test-results/

# UI soak output (logs + failure artifacts)
frontend/tests/e2e/soak/

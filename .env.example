NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
POSTGRES_URL=postgresql+asyncpg://intel:changeme@localhost:5432/intel_platform
API_KEY=dev-api-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000
# Per-client req/min cap. High for the single-user workbench (the SPA fires many
# calls per page, all sharing one IP behind the local frontend proxy); lower it
# for public deployments.
RATE_LIMIT_PER_MINUTE=3000
# Security hardening for public/deployed instances. When true, the app refuses
# to start with the built-in default JWT secret / API key / admin password.
REQUIRE_SECURE_AUTH=false
DEFAULT_ADMIN_PASSWORD=
# MCP server exposes read+write graph tools and is NOT behind the REST auth — off by default.
MCP_ENABLED=false
EXTRACTION_MODE=nlp
SPACY_MODEL=en_core_web_sm
# Storage-time confidence floor for blanket ASSOCIATED_WITH co-occurrence
# edges (typed/pattern-derived and LLM relationships are unaffected).
COOCCURRENCE_CONFIDENCE_MIN=0.55
JWT_SECRET=intel-platform-dev-secret-change-in-production
CHUNK_SIZE=2000
CHUNK_OVERLAP=50

# Collection / agentic crawl
COLLECTION_CRAWL_CONCURRENCY=4
# Dedicated provider for bulk collection work (source resolution + per-doc
# summaries) so high-volume crawling won't drain a rate-limited cloud key.
# Empty = use the default provider; set to "ollama" to offload locally.
COLLECTION_LLM_PROVIDER=
# Model for the collection provider; blank defaults to qwen2.5:14b when ollama.
COLLECTION_LLM_MODEL=

# LLM Providers (set keys for providers you want to use)
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:14b

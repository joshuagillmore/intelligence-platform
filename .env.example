NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
POSTGRES_URL=postgresql+asyncpg://intel:changeme@localhost:5432/intel_platform
# API_KEY is a legacy bearer token for programmatic / service-to-service callers
# that authenticates as admin. SECURITY: this built-in placeholder value is
# REJECTED by the auth layer (it ships in this file, so anyone could read it) —
# set a strong, unique value for the API-key path to work at all. The browser
# frontend does not use this path; it authenticates with a JWT from login.
API_KEY=dev-api-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000
# Per-client req/min cap. High for the single-user workbench (the SPA fires many
# calls per page, all sharing one IP behind the local frontend proxy); lower it
# for public deployments.
RATE_LIMIT_PER_MINUTE=3000
# Trust the X-Forwarded-For header for the client IP used in rate limiting and
# login throttling. Keep false locally; set true ONLY behind a trusted reverse
# proxy (e.g. Railway), where the real client IP is otherwise hidden. The
# leftmost X-Forwarded-For entry is used when enabled.
TRUST_PROXY_HEADERS=false
# PRODUCTION SWITCH. Leave false for local `docker compose up`. Set to true on
# any public/deployed instance: the app then refuses to start with the built-in
# default JWT_SECRET or API_KEY (fail-closed). Regardless of this flag, a loud
# WARNING is logged at boot whenever any default secret is still in place.
REQUIRE_SECURE_AUTH=false
# Seed password for the auto-created 'admin' user. Blank -> 'admin' in dev (a
# warning is logged). Set a strong value in production; REQUIRE_SECURE_AUTH=true
# refuses to seed a default-'admin' account.
DEFAULT_ADMIN_PASSWORD=
# MCP server exposes read+write graph tools and is NOT behind the REST auth — off by default.
MCP_ENABLED=false
# nlp | llm | hybrid. hybrid (NLP + LLM) gives typed, evidence-backed
# relationships and higher-precision entities; falls back to NLP if no LLM
# provider is reachable. (docker-compose sets this to hybrid for local dev.)
EXTRACTION_MODE=hybrid
# Route per-document extraction to a dedicated provider so it won't drain a
# rate-limited cloud key. Empty = default provider; "ollama" = local model.
EXTRACTION_LLM_PROVIDER=
EXTRACTION_LLM_MODEL=
SPACY_MODEL=en_core_web_sm
# Resolve pronouns to their antecedents before extraction (more relationships,
# slower). Off by default.
COREFERENCE_ENABLED=false
# Cosine-similarity floor for merging two mentions into the same entity during
# entity resolution (higher = stricter, fewer merges).
ENTITY_RESOLUTION_THRESHOLD=0.92
# Drop extracted entities below this confidence (0.0 = keep all).
EXTRACTION_CONFIDENCE_MIN=0.0
# Storage-time confidence floor for blanket ASSOCIATED_WITH co-occurrence
# edges (typed/pattern-derived and LLM relationships are unaffected).
COOCCURRENCE_CONFIDENCE_MIN=0.55
JWT_SECRET=intel-platform-dev-secret-change-in-production
# Characters of a single crawled document kept and extracted from. Guards
# against one very large page becoming hundreds of sequential LLM calls, and
# keeps every extracted entity's evidence inside the stored document.
MAX_DOCUMENT_CHARS=50000
CHUNK_SIZE=2000
CHUNK_OVERLAP=50

# Collection / agentic crawl
COLLECTION_CRAWL_CONCURRENCY=4
# Dedicated provider for bulk collection work (source resolution + per-doc
# summaries) so high-volume crawling won't drain a rate-limited cloud key.
# Empty = use the default provider; set to "ollama" to offload locally.
COLLECTION_LLM_PROVIDER=
# Model for the collection provider; blank defaults to qwen2.5:14b when ollama.
COLLECTION_LLM_MODEL=

# Search engines tried in order (comma-separated); the first to return anything
# wins. ddgs fronts several engines that fail independently, and the duckduckgo
# backend in particular returns nothing under light load for queries brave and
# bing answer immediately — a single-engine search starves collection silently.
# Blank uses the default order below.
SEARCH_BACKENDS=auto,brave,bing,duckduckgo

# LLM Providers (set keys for providers you want to use)
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:14b

# --- Embeddings & vector search --------------------------------------------
# Powers semantic/vector search and document clustering. NOTE: the Postgres
# vector column is fixed at 1536 dimensions, so today only "openai" (1536-d,
# needs OPENAI_API_KEY above) actually fits. The "ollama" (nomic-embed-text,
# 768-d) and "cohere" (1024-d) providers exist but their vectors won't store
# until the column dimension is made configurable. Without a working embedding
# provider the app still runs — retrieval just falls back to graph-only.
EMBEDDING_PROVIDER=openai        # openai | cohere | ollama
EMBEDDING_MODEL=                 # blank = provider default (openai: text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536        # must match the pgvector column (currently 1536)
# Max chunks returned by a vector search, and the weight given to graph results
# (vs vector results) when the two are blended in hybrid retrieval.
VECTOR_SEARCH_LIMIT=20
HYBRID_GRAPH_WEIGHT=0.4

# ---------------------------------------------------------------------------
# Optional collection-egress VPN/Tor (OFF by default)
# ---------------------------------------------------------------------------
# Routes ONLY the web-collection egress (crawl4ai + ddgs + httpx connectors)
# through a selectable proxy — chosen at runtime from the admin API
# (Off / VPN / Tor), persisted in Postgres. LLM/cloud API calls always stay
# direct. The mode defaults to "direct" (no proxy) until an admin switches it.
#
# The VPN/Tor sidecars run ONLY under the compose "vpn" profile:
#     docker compose --profile vpn up
# This path is LOCAL / self-hosted only: gluetun needs NET_ADMIN + /dev/net/tun,
# which Railway cannot grant. Tor works anywhere. (Plain `docker compose up`
# without the profile is unaffected and needs none of the vars below.)
#
# The values below configure the gluetun sidecar. Get them from Surfshark →
# Manual setup → WireGuard (recommended) or OpenVPN.
SURFSHARK_VPN_TYPE=wireguard
# WireGuard (SURFSHARK_VPN_TYPE=wireguard):
SURFSHARK_WG_PRIVATE_KEY=
SURFSHARK_WG_ADDRESSES=
# OpenVPN (SURFSHARK_VPN_TYPE=openvpn):
SURFSHARK_OVPN_USER=
SURFSHARK_OVPN_PASSWORD=
# Exit-country selection for the VPN sidecar.
SURFSHARK_COUNTRIES=Netherlands
# Backend → sidecar wiring (compose service names; usually leave as-is).
# VPN_HTTP_PROXY / TOR_SOCKS_PROXY are the egress proxies; GLUETUN_CONTROL_URL
# is queried directly (not through the tunnel) for VPN status / kill-switch.
VPN_HTTP_PROXY=http://gluetun:8888
TOR_SOCKS_PROXY=socks5h://tor:9050
GLUETUN_CONTROL_URL=http://gluetun:8000
# Optional X-API-Key for the gluetun control server (blank = no auth).
GLUETUN_CONTROL_APIKEY=

# --- Cyber enrichment ------------------------------------------------------
# Related-data lookups for cyber observables (WHOIS/RDAP, DNS, GeoIP, cert
# transparency, CISA KEV, NVD). All providers are keyless. The NVD key is
# OPTIONAL and only raises NVD's rate limit (get one free at nvd.nist.gov).
# On-demand "Investigate" is always available; auto-enrich of newly-seen cyber
# nodes at ingest is OFF by default and toggled on the admin screen (persisted
# in AppSetting "enrichment_auto_enabled"). Enrichment egress uses the same
# collection proxy above (VPN/Tor), never the LLM path.
NVD_API_KEY=

# --- Geo enrichment (Nominatim/Overpass; keyless) --------------------------
# Geocoding + admin hierarchy (place -> country/state/province/county/city/
# neighbourhood/postal) and local POIs. Public endpoints cap at ~1 req/s and
# forbid bulk; point the base URLs at self-hosted Nominatim/Overpass for scale.
# Nominatim ToS requires a descriptive User-Agent. GEONAMES_USERNAME is optional.
GEO_USER_AGENT=intel-platform/1.0 (geo enrichment)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
GEONAMES_USERNAME=

# --- MITRE ATT&CK® (keyless) -----------------------------------------------
# The Enterprise STIX 2.1 bundle is pinned by version and fetched on demand via
# POST /api/attack/ingest (~50 MB, cached to data/attack/, gitignored — never
# committed). Point the base URL at a mirror to change source. Attribution is in
# data/attack/ATTRIBUTION.md and MUST ship with any redistribution.
ATTACK_STIX_VERSION=19.1
ATTACK_STIX_BASE_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack
# Phase 2 text->technique mapping (RAG): POST /api/attack/embed embeds the
# technique catalog into pgvector; POST /api/attack/map retrieves the top-K
# nearest candidates per TTP and an LLM confirms matches at/above the floor.
ATTACK_MAPPING_TOP_K=5
ATTACK_MAPPING_CONFIDENCE_MIN=0.5
# Max TTPs mapped per /attack/map run (cost/latency guard; over-cap TTPs wait for the next run).
ATTACK_MAPPING_MAX_TTPS=200
# Phase 3a CVE->ATT&CK chaining (CWE->CAPEC->ATT&CK). POST /api/attack/ingest-vuln-chain
# fetches these two keyless, redistributable MITRE files on demand (~4 MB zip + ~6 MB
# XML, cached to data/attack/, gitignored) and loads (:Cwe)-[:ENABLES]->(:AttackTechnique).
# URLs are config-driven so a mirror is a .env swap.
CWE_XML_URL=https://cwe.mitre.org/data/xml/cwec_latest.xml.zip
CAPEC_XML_URL=https://capec.mitre.org/data/xml/capec_latest.xml
# Phase 3b D3FEND defensive countermeasures. GET /api/attack/technique/{tid}/d3fend
# lazily fetches the per-technique offensive->defensive mapping (keyless), caches it
# in Postgres for ATTACK_D3FEND_TTL_DAYS, and degrades to [] on any outage. Base URL
# is config-driven so a mirror is a .env swap.
D3FEND_API_BASE=https://d3fend.mitre.org/api/offensive-technique/attack
ATTACK_D3FEND_TTL_DAYS=30

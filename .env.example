NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
POSTGRES_URL=postgresql+asyncpg://intel:changeme@localhost:5432/intel_platform
API_KEY=dev-api-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000
# Per-client req/min cap. High for the single-user workbench (the SPA fires many
# calls per page, all sharing one IP behind the local frontend proxy); lower it
# for public deployments.
RATE_LIMIT_PER_MINUTE=3000
# Security hardening for public/deployed instances. When true, the app refuses
# to start with the built-in default JWT secret / API key / admin password.
REQUIRE_SECURE_AUTH=false
DEFAULT_ADMIN_PASSWORD=
# MCP server exposes read+write graph tools and is NOT behind the REST auth — off by default.
MCP_ENABLED=false
# nlp | llm | hybrid. hybrid (NLP + LLM) gives typed, evidence-backed
# relationships and higher-precision entities; falls back to NLP if no LLM
# provider is reachable. (docker-compose sets this to hybrid for local dev.)
EXTRACTION_MODE=hybrid
# Route per-document extraction to a dedicated provider so it won't drain a
# rate-limited cloud key. Empty = default provider; "ollama" = local model.
EXTRACTION_LLM_PROVIDER=
EXTRACTION_LLM_MODEL=
SPACY_MODEL=en_core_web_sm
# Storage-time confidence floor for blanket ASSOCIATED_WITH co-occurrence
# edges (typed/pattern-derived and LLM relationships are unaffected).
COOCCURRENCE_CONFIDENCE_MIN=0.55
JWT_SECRET=intel-platform-dev-secret-change-in-production
CHUNK_SIZE=2000
CHUNK_OVERLAP=50

# Collection / agentic crawl
COLLECTION_CRAWL_CONCURRENCY=4
# Dedicated provider for bulk collection work (source resolution + per-doc
# summaries) so high-volume crawling won't drain a rate-limited cloud key.
# Empty = use the default provider; set to "ollama" to offload locally.
COLLECTION_LLM_PROVIDER=
# Model for the collection provider; blank defaults to qwen2.5:14b when ollama.
COLLECTION_LLM_MODEL=

# LLM Providers (set keys for providers you want to use)
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# Optional collection-egress VPN/Tor (OFF by default)
# ---------------------------------------------------------------------------
# Routes ONLY the web-collection egress (crawl4ai + ddgs + httpx connectors)
# through a selectable proxy — chosen at runtime from the admin API
# (Off / VPN / Tor), persisted in Postgres. LLM/cloud API calls always stay
# direct. The mode defaults to "direct" (no proxy) until an admin switches it.
#
# The VPN/Tor sidecars run ONLY under the compose "vpn" profile:
#     docker compose --profile vpn up
# This path is LOCAL / self-hosted only: gluetun needs NET_ADMIN + /dev/net/tun,
# which Railway cannot grant. Tor works anywhere. (Plain `docker compose up`
# without the profile is unaffected and needs none of the vars below.)
#
# The values below configure the gluetun sidecar. Get them from Surfshark →
# Manual setup → WireGuard (recommended) or OpenVPN.
SURFSHARK_VPN_TYPE=wireguard
# WireGuard (SURFSHARK_VPN_TYPE=wireguard):
SURFSHARK_WG_PRIVATE_KEY=
SURFSHARK_WG_ADDRESSES=
# OpenVPN (SURFSHARK_VPN_TYPE=openvpn):
SURFSHARK_OVPN_USER=
SURFSHARK_OVPN_PASSWORD=
# Exit-country selection for the VPN sidecar.
SURFSHARK_COUNTRIES=Netherlands
# Backend → sidecar wiring (compose service names; usually leave as-is).
# VPN_HTTP_PROXY / TOR_SOCKS_PROXY are the egress proxies; GLUETUN_CONTROL_URL
# is queried directly (not through the tunnel) for VPN status / kill-switch.
VPN_HTTP_PROXY=http://gluetun:8888
TOR_SOCKS_PROXY=socks5h://tor:9050
GLUETUN_CONTROL_URL=http://gluetun:8000
# Optional X-API-Key for the gluetun control server (blank = no auth).
GLUETUN_CONTROL_APIKEY=

# --- Cyber enrichment ------------------------------------------------------
# Related-data lookups for cyber observables (WHOIS/RDAP, DNS, GeoIP, cert
# transparency, CISA KEV, NVD). All providers are keyless. The NVD key is
# OPTIONAL and only raises NVD's rate limit (get one free at nvd.nist.gov).
# On-demand "Investigate" is always available; auto-enrich of newly-seen cyber
# nodes at ingest is OFF by default and toggled on the admin screen (persisted
# in AppSetting "enrichment_auto_enabled"). Enrichment egress uses the same
# collection proxy above (VPN/Tor), never the LLM path.
NVD_API_KEY=

# --- Geo enrichment (Nominatim/Overpass; keyless) --------------------------
# Geocoding + admin hierarchy (place -> country/state/province/county/city/
# neighbourhood/postal) and local POIs. Public endpoints cap at ~1 req/s and
# forbid bulk; point the base URLs at self-hosted Nominatim/Overpass for scale.
# Nominatim ToS requires a descriptive User-Agent. GEONAMES_USERNAME is optional.
GEO_USER_AGENT=intel-platform/1.0 (geo enrichment)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
GEONAMES_USERNAME=
